# Copy this file to .env and fill in your own values. The .env file is never committed.
# src/config/env.ts checks these at startup, and the server refuses to start if one is missing.

# Server
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173

# Database. Docker Compose reads POSTGRES_PASSWORD, and the app never does. Use only letters and
# digits, because the same password goes in DATABASE_URL below. It only takes effect when the
# database volume is first created.
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://yerevan:change_me@localhost:5432/yerevan_dev

# Demo accounts. Only `npm run db:seed` reads this: every demo account gets it as its password,
# the admin's too, so make it strong (8 to 128 characters). The server starts without it, which is
# why it's commented out here. Changing it later means rebuilding: db:reset, then db:seed.
# DEMO_PASSWORD=

# Auth. Generate a real secret with: openssl rand -base64 32
JWT_ACCESS_SECRET=change_me
GOOGLE_CLIENT_ID=your-google-client-id

# Google Places API (New). Restrict the key to that API.
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Resend
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="Seghan <bookings@your-domain>"
