# Copy this file to .env and fill in your own values. The .env file is never committed.
# src/config/env.ts checks these at startup, and the server refuses to start if one is missing.

# Server
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173

# Database. Use the same password as POSTGRES_PASSWORD in the root .env.
DATABASE_URL=postgresql://yerevan:change_me@localhost:5432/yerevan_dev

# Integration tests only, and the app never reads it. It must point at yerevan_test, because the
# tests refuse anything else and erase this database on every run. Use the same password as above.
TEST_DATABASE_URL=postgresql://yerevan:change_me@localhost:5432/yerevan_test

# Auth. Generate a real secret with: openssl rand -base64 32
JWT_ACCESS_SECRET=change_me
GOOGLE_CLIENT_ID=your-google-client-id

# Google Places API (New). Restrict the key to that API.
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Resend
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM="Seghan <bookings@your-domain>"
