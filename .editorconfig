# Basic file rules that editors apply automatically. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# In Markdown, two spaces at the end of a line mean a line break, so keep them.
[*.md]
trim_trailing_whitespace = false
